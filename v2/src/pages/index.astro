---
/**
 * Home. Sections in document order: hero, intro, works, cta.
 *
 * Images are imported rather than referenced by path so Vite hashes
 * them and the intrinsic dimensions come from the file — no hardcoded
 * width/height to drift out of sync with the asset.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Signature from '../components/Signature.astro';
import { works, indexOf, hrefOf } from '../data/works.js';

import logoAdplist from '../assets/images/logo-adplist.webp';
import logoFacilio from '../assets/images/logo-facilio.webp';
import logoFigma from '../assets/images/logo-figma.webp';
import logoJisr from '../assets/images/logo-jisr.webp';
import logoKissflow from '../assets/images/logo-kissflow.webp';
import logoSalesforce from '../assets/images/logo-salesforce.webp';
import logoScarlettt from '../assets/images/logo-scarlettt.webp';
import logoZapro from '../assets/images/logo-zapro.webp';
import portrait from '../assets/images/portrait.webp';
---

<BaseLayout
  title="Sivaganesh — Designer"
  description="Designer building brand and product presence for founders. Great founders changing the world deserve a presence as powerful as what they're building."
  ogImage={portrait.src}
>
  <!-- ══════════════════════════════════════════════════════════
       HERO — live word marquee, white vignette, glass portrait
  ═══════════════════════════════════════════════════════════ -->
  <section class="hero" aria-labelledby="hero-heading">
    <h1 class="visually-hidden" id="hero-heading">
      Sivaganesh — designer building brand and product presence for founders
    </h1>

    <div class="hero__field" aria-hidden="true" data-hero-field>
      <!-- Rows are generated by marquee.js: alternating scroll
           directions, sized to whatever the hero currently is. -->
      <div class="hero__marquee" data-hero-marquee data-marquee></div>
      <div class="hero__vignette"></div>
    </div>

    <!-- Glass frame: 12% white fill, 8px backdrop blur, white border,
         4% white inner glow. All of it in CSS on this one element. -->
    <figure class="portrait" data-portrait>
      <div class="portrait__frame">
        <img
          class="portrait__img"
          src={portrait.src}
          alt="Portrait of Sivaganesh"
          width={portrait.width}
        height={portrait.height}
          fetchpriority="high"
          data-portrait-img
        />
      </div>
    </figure>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       INTRO — statement, signature, collaborated brands
  ═══════════════════════════════════════════════════════════ -->
  <section class="intro" id="about" aria-labelledby="intro-label">
    <div class="shell intro__inner">

      <div class="row">
        <p class="row__label" id="intro-label">A quick intro</p>

        <div class="row__body intro__body">
          <div class="intro__copy" data-reveal-lines>
            <p>
              Great founders changing the world deserve a presence as powerful
              as what they're building. Most founders we work with have built
              something significant, but their website doesn't show it yet.
            </p>
            <p>
              That gap costs more than revenue. It costs the certainty that
              your brand is finally being understood.
            </p>
          </div>

          <p class="intro__signature" data-signature>
            <!-- Centerline stroke paths generated from the filled
                 master artwork by scripts/centerline.py. Inline (not an
                 <img>) because stroke-dashoffset has to reach the path
                 elements. Traced in writing order by intro.js. -->
            <Signature />
          </p>
        </div>
      </div>

      <div class="row">
        <p class="row__label" id="brands-label">Collaborated brands</p>

        <div class="row__body">
          <ul class="brands" aria-labelledby="brands-label" data-brands>
            <li class="brands__item"><img src={logoFacilio.src}    alt="Facilio"          loading="lazy" /></li>
            <li class="brands__item"><img src={logoKissflow.src}   alt="Kissflow"         loading="lazy" /></li>
            <li class="brands__item"><img src={logoJisr.src}       alt="Jisr"             loading="lazy" /></li>
            <li class="brands__item"><img src={logoZapro.src}      alt="Zapro"            loading="lazy" /></li>
            <li class="brands__item"><img src={logoFigma.src}      alt="Friends of Figma" loading="lazy" /></li>
            <li class="brands__item"><img src={logoAdplist.src}    alt="ADPList"          loading="lazy" /></li>
            <li class="brands__item"><img src={logoSalesforce.src} alt="Salesforce"       loading="lazy" /></li>
            <li class="brands__item"><img src={logoScarlettt.src}  alt="Scarlettt"        loading="lazy" /></li>
          </ul>
        </div>
      </div>

    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       WORKS — four case studies, sticky label column
  ═══════════════════════════════════════════════════════════ -->
  <section class="works" id="works" aria-labelledby="works-label">
    <div class="shell">
      <div class="row works__row">
        <p class="row__label works__label" id="works-label">Selected works</p>

        <div class="row__body works__list">

          <!-- Cards come from data/works.js so the hrefs, the 01/04 numbering
               and the Next-project chain cannot drift apart.
               NOTE the overlay link must stay a DIRECT child of .work: the
               index and text are transformed by GSAP (and carry
               will-change), which makes them containing blocks AND stacking
               contexts, so an overlay nested inside one gets trapped at that
               element's bounds instead of the card's. -->
          {works.map((work) => (
            <article class="work" data-work data-cursor="read">
              <div class="work__media">
                <img src={work.cover.src} alt="" loading="lazy" data-work-img />
                <span class="work__panel" aria-hidden="true" data-work-panel></span>
              </div>
              <div class="work__info">
                <p class="work__index mono">{indexOf(work.slug)}</p>
                <div class="work__text">
                  <h2 class="work__title">{work.name}</h2>
                  <p class="work__desc">{work.tagline}</p>
                </div>
              </div>
              <a
                class="work__link"
                href={hrefOf(work.slug)}
                aria-label={`${work.name} — read the case study`}
              ></a>
            </article>
          ))}

        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       CTA — closing statement
  ═══════════════════════════════════════════════════════════ -->
  <footer class="cta" aria-labelledby="cta-heading">
    <!-- Kinetic grid backdrop. Empty on purpose: kinetic.js appends
         the canvas and drives the lattice from the pointer. -->
    <div class="kinetic" data-kinetic aria-hidden="true"></div>

    <div class="cta__inner">
      <h2 class="cta__headline mono" id="cta-heading">
        <span class="cta__line cta__line--start" data-cta-line>Let&rsquo;s build</span>
        <span class="cta__line cta__line--end"   data-cta-line>An experience</span>
      </h2>

      <div class="cta__actions">
        <a class="pill pill--light" href="https://www.linkedin.com/in/sivaganesh-s/" target="_blank" rel="noopener noreferrer" data-magnetic>Linkedin</a>
        <a class="pill pill--light" href="mailto:sivag@facilio.com" data-magnetic>Mail me</a>
      </div>
    </div>
  </footer>
  <script>
    import '../js/pages/home.js';
  </script>
</BaseLayout>
