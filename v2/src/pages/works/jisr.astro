---
/**
 * Jisr. Deliberately has NO stats block — this is the shape the brief
 * called for: pages that differ. Two text blocks, two previews, and the
 * previews band carries no closing statement either.
 */
import CaseLayout from '../../layouts/CaseLayout.astro';
import CaseHeader from '../../components/case/CaseHeader.astro';
import CaseCover from '../../components/case/CaseCover.astro';
import CaseText from '../../components/case/CaseText.astro';
import CasePreviews from '../../components/case/CasePreviews.astro';
import NextProject from '../../components/case/NextProject.astro';
import { bySlug, hrefOf, nextAfter, LEAD, GAP, RESPONSIBILITIES } from '../../data/works.js';

const work = bySlug('jisr');
const next = nextAfter('jisr');
---

<CaseLayout
  title={`${work.name} — Case study · Sivaganesh`}
  description={work.tagline}
  ogImage={work.cover.src}
>
  <CaseHeader company={work.name} responsibilities={RESPONSIBILITIES} statement={LEAD} />
  <CaseCover alt={`${work.name} HR and payroll software`} />

  <CaseText label="A quick intro" rows={[[LEAD, GAP], [LEAD, GAP]]} />
  <CaseText label="Localisation" rows={[[LEAD, GAP]]} />

  <CasePreviews
    headingStart="Design"
    headingEnd="Previews"
    placeholderCount={2}
  />

  <NextProject href={hrefOf(next.slug)} next={next.name} />
</CaseLayout>
